{
    "version": 1,
    "protocol": 1,
    "pamNative": {
        "minimum": "1.46.0",
        "maximumExclusive": "2.0.0"
    },
    "php": {
        "provider": "Pam\\Native\\Toast\\ToastPluginProvider"
    },
    "android": {
        "namespace": "dev.pam.toast",
        "minSdk": 26,
        "sourceDirs": [
            "android/src/main/kotlin"
        ],
        "dependencies": [
            "androidx.core:core-ktx:1.17.0"
        ]
    },
    "ios": {
        "minimumVersion": "15.0",
        "sourceDirs": [
            "ios/Sources"
        ],
        "frameworks": [
            "CoreText",
            "ImageIO",
            "UIKit"
        ]
    },
    "modules": [
        {
            "name": "toast",
            "class": "dev.pam.toast.ToastModule",
            "iosClass": "ToastModule"
        }
    ],
    "views": []
}
